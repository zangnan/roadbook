# 高德地图 Web 端 Key（用于地图展示 AMap.Map）
AMAP_WEB_AK=xxx

# 高德地图 Web 服务 Key（用于逆地理编码 API）
AMAP_SERVER_AK=xxx

# 高德地图 JS API 安全密钥（jscode）
# 2021-12-02 之后新建的 Key 必须配套填写，否则地图会报 INVALID_USER_SCODE 加载失败
# 在「高德开放平台 → 应用管理 → 我的应用」中与 Key 一起生成
AMAP_SECURITY_CODE=

# 原图压缩质量 (1-100)，数值越小文件越小但质量越低
ORIGINAL_IMAGE_QUALITY=80

# 坐标合并阈值 - 距离阈值（米）
DISTANCE_THRESHOLD=1000

# 坐标合并阈值 - 时间阈值（秒）
TIME_THRESHOLD=7200

# 缓存类型: 'sqlite' 或 'json'
CACHE_TYPE=sqlite

# 照片根目录（相对于 exe 所在目录）
# 相对路径示例：\photo
PHOTO_BASE_DIR=\photo

# 输出根目录（相对于 exe 所在目录）
# 相对路径示例：\output
OUTPUT_BASE_DIR=\output

# 端口配置
WEB_PORT=18443
DESKTOP_PORT=12255

# DeepSeek AI（「AI 生成路书」必填，不填接口会返回 500）
# 申请地址：https://platform.deepseek.com/api_keys
# 也支持任意 OpenAI 兼容接口，改 API_URL 与 MODEL 即可
#   硅基流动：https://api.siliconflow.cn/v1      模型如 deepseek-ai/DeepSeek-V3
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat